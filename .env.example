# ==============================================================================
# CIET ERP — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' at the project root for local development.
# IMPORTANT: NEVER commit '.env' files containing real secrets to version control!
# ==============================================================================

# --- Server Configuration ---
PORT=8080

# --- Database Configuration (MongoDB) ---
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/erp_portal
# For MongoDB Atlas (replace with your secure credentials and restrict IP allowlist):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/erp_portal?retryWrites=true&w=majority
MONGODB_NAME=erp_portal

# --- JWT Authentication Secrets ---
# Generate a secure 256-bit hex or base64 key for production:
# e.g., openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail / SMTP Configuration (2FA OTP & Notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@ciet.edu.in

# --- Initial Administrator (Director) Account Seeding ---
# If left blank, a secure random password will be auto-generated on first startup and logged.
DIRECTOR_EMAIL=admin@ciet.edu.in
DIRECTOR_PASSWORD=

# --- Frontend Client Configuration ---
VITE_API_URL=http://localhost:8080
